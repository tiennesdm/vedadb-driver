{
    "name": "vedadb/vedadb",
    "description": "Official PHP driver for VedaDB - The Multi-Model Database Engine",
    "version": "1.0.0",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "VedaDB Contributors"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "ext-sockets": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "VedaDB\\": "src/",
            "VedaDB\\Wire\\Vbp\\": "src/VedaDB/Wire/Vbp/"
        },
        "files": [
            "src/VedaException.php",
            "src/VedaDB/Wire/Vbp/VBPProtocolError.php",
            "src/VedaDB/Wire/Vbp/VBPProtocolException.php",
            "src/VedaDB/Wire/Vbp/VBPException.php",
            "src/VedaDB/Wire/Vbp/VBPError.php",
            "src/VedaDB/Wire/Vbp/VBPScramState.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "VedaDB\\Tests\\": "tests/"
        }
    },
    "keywords": [
        "vedadb",
        "database",
        "multi-model",
        "sql",
        "nosql",
        "cache",
        "search",
        "graph",
        "driver",
        "pdo",
        "connection-pool",
        "pubsub",
        "change-streams",
        "circuit-breaker",
        "load-balancer",
        "failover"
    ],
    "homepage": "https://github.com/vedadb/vedadb",
    "support": {
        "issues": "https://github.com/vedadb/vedadb/issues",
        "source": "https://github.com/vedadb/vedadb/tree/main/drivers/php"
    },
    "scripts": {
        "test": "phpunit",
        "check": "php -l src/*.php",
        "lint": "find src -name '*.php' -exec php -l {} \\;"
    }
}
