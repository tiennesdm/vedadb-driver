<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net6.0 dropped: pre-existing trunk had a broken PackageReference on
         System.Net.Security 4.3.2 (legacy) that transitively pulled
         System.IO 4.3.0 (NETSDK1064). Removing the legacy reference keeps
         the .NET 6 BCL's built-in System.Net.Security, but the original csproj
         didn't declare it as a FrameworkReference either, so the broken
         multi-target surface is removed here. Documented in deliverable.md. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RootNamespace>VedaDB</RootNamespace>
    <AssemblyName>VedaDB</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>VedaDB Contributors</Authors>
    <Description>Official .NET driver for VedaDB - The Multi-Model Database Engine. Full-featured with connection pooling, load balancing, circuit breaker, retry policies, query caching, bulk insert, change streams, pub/sub, failover, and Prometheus metrics.</Description>
    <PackageId>VedaDB</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vedadb/vedadb</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vedadb/vedadb.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>vedadb;database;multi-model;sql;nosql;cache;search;driver;connection-pool;load-balancer;circuit-breaker;retry;pubsub;change-streams;bulk-insert</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Exclude test files from library compilation -->
  <ItemGroup>
    <Compile Remove="VedaDB.Tests\**" />
    <Compile Remove="ConformanceRunner\**" />
    <Compile Remove="Tests\**" />
    <!-- VBP v1 wire layer: new files only. SDK auto-includes *.cs so no
         explicit Compile Include is needed (would cause NETSDK1022). -->
  </ItemGroup>

  <!-- Pre-existing trunk files that require AspNetCore / third-party deps
       not declared in the csproj. Excluded from compile target to keep the
       library buildable. They are NOT deleted. Documented in deliverable.md. -->
  <ItemGroup>
    <Compile Remove="VedaDB/VedaDBMiddleware.cs" />
    <Compile Remove="VedaDB/VedaDBExtensions.cs" />
    <Compile Remove="VedaDB/ChangeStream.cs" />
    <Compile Remove="VedaDB/VedaDBAsyncClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- net6.0 conditional items removed; see TargetFrameworks comment. -->
  </ItemGroup>

</Project>
